{
  "pre_trained_path": "weights/stable-video-diffusion-img2vid-xt-1-1/",
  "unet_path": "weights/StereoCrafter/",
  "train_glob": "video_data/train/*.mp4",
  "save_dir": "weights/",
  "dataset_split_ratios": [8, 1, 1],
  "dataset_split_group": "train",
  "dataset_split_seed": 7,
  "val_split": "val",
  "val_interval_epochs": 2,
  "frames_chunk": 14,
  "overlap": 3,
  "use_prev_target_overlap": true,
  "overlap_teacher_prob": 0.3,
  "overlap_noise_std": 0.01,
  "stage_epochs": [50, 50, 3],
  "stage_learning_rates": [1e-5, 1e-5, 1e-6],
  "mamba_learning_rate": 5e-5,
  "mamba_diag_interval": 10,
  "target_avg_loss": null,
  "precision": "bf16",
  "diffusion_scheduler_type": "euler",
  "euler_train_num_steps": 20,
  "denoise_diag_interval": 100,
  "checkpoint_use_reentrant": true,
  "mamba_auto_fallback": true,
  "grad_accum_steps": 1,
  "deepspeed": {
    "enabled": true,
    "zero_stage": 2,
    "offload_optimizer_device": "cpu",
    "offload_param_device": "none",
    "reduce_bucket_size": 50000000,
    "allgather_bucket_size": 50000000,
    "gradient_accumulation_steps": 1,
    "deepspeed_config_path": null
  },
  "stage_overrides": {
    "3": {
      "frames_chunk": 4,
      "overlap": 1,
      "deepspeed": {
        "offload_optimizer_device": "cpu",
        "offload_param_device": "cpu"
      }
    }
  },
  "max_stage_idx": 3,
  "preflight_all_stages_before_train": false,
  "preflight_exit_after_all_stages": false,
  "scheduler_type": "cosine_with_warmup",
  "num_warmup_steps": 2,
  "save_interval_epochs": 25 ,
  "vae_encode_chunk_size": 1,
  "attn": "auto",
  "ff_chunk_size": 64,
  "ff_chunk_dim": 1,
  "debug_deepspeed_graph": true,
  "debug_deepspeed_param_scan": true,
  "resume_from": null,
  "unet_shard_mode": "auto",
  "unet_shard_strategy": "frontload_gpu1",
  "per_gpu_max_mem_gib": [20, 20],
  "scheduler_t_max": 50,
  "scheduler_eta_min": 1e-6
}
