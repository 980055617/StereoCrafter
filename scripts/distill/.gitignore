runs/**/*.pt
runs/**/*.log
# Inference renders and visual strips produced by the run lanes (2.2 GB as of 2026-10-01).
# The numbers they back are committed as .txt/.json/.csv next to them.
runs/**/*.mp4
runs/**/*.mkv
runs/**/*.png
# Local link farms into video_data/ (machine-specific absolute symlinks; rebuild from the
# split JSON, e.g. train_gt27 = video_data/train_gt28 minus 0358).
splits/train_gt*/
# Run plumbing (2026-10-04): completion sentinels read by the capture/eval lanes, progress files, captured process
# output (same role as *.log) and binary arrays. They stay on disk for the scripts; git keeps only the records.
runs/**/*.done
runs/**/*.ready
runs/**/*_progress.txt
runs/**/*.stdout
runs/**/*.stderr
runs/**/*.npy
runs/**/*.npz
